{
	"env": {
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"DISABLE_AUTOUPDATER": "1"
	},
	"permissions": {
		"deny": [
			"Read(.env)",
			"Read(**/*.pem)",
			"Read(**/*id_rsa*)",
			"Read(**/*id_ed25519*)",
			"Read(~/.ssh/**)",
			"Read(~/.aws/**)",
			"Read(~/.gnupg/**)",
			"Edit(.env)",
			"Write(.env)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/session-start.sh",
						"timeout": 5000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/pre-bash.sh",
						"timeout": 2000
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "jq -r '.tool_input.file_path' | { read file_path; if [ -n \"$file_path\" ] && [ -x ~/.claude/hooks/post-edit.sh ]; then ~/.claude/hooks/post-edit.sh \"$file_path\"; fi; }"
					}
				]
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ \"$(uname)\" = Darwin ] && afplay -v 1.0 /System/Library/Sounds/Glass.aiff || printf '\\a'"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ \"$(uname)\" = Darwin ] && afplay -v 2.0 /System/Library/Sounds/Bottle.aiff || printf '\\a'"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
					}
				]
			}
		]
	},
	"statusLine": {
		"type": "command",
		"command": "~/dotfiles/bin/cc-statusline"
	},
	"enabledPlugins": {
		"commit-commands@claude-plugins-official": true,
		"ralph-loop@claude-plugins-official": true,
		"frontend-design@claude-plugins-official": true,
		"clangd-lsp@claude-plugins-official": true
	},
	"effortLevel": "high",
	"skipDangerousModePermissionPrompt": true
}
